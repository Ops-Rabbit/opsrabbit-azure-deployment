FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap ca-certificates && rm -rf /var/lib/apt/lists/* \
 && useradd -u 1000 -m probe && mkdir -p /workspace && chown probe:probe /workspace
COPY probe.py /opt/probe.py
USER 1000:1000
EXPOSE 8080
CMD ["python", "/opt/probe.py"]
